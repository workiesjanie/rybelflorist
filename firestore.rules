rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Admin authentication profile
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('isAdmin', false) == false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Katalog produk publik, modifikasi hanya oleh admin
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Kategori produk publik, modifikasi hanya oleh admin
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Pesanan (Guest Checkout): Siapa saja bisa membuat order pending, baca/ubah hanya admin
    match /orders/{orderId} {
      allow create: if request.resource.data.get('orderStatus', '') == 'pending'
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow read, update, delete: if isAdmin();
    }

    // Pengaturan toko & ongkir publik
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Log aktivitas admin
    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}

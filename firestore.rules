rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('isAdmin', false) == false;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','phone','address','city','state','zipCode','country','updatedAt']));
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('orderStatus', '') == 'pending'
        && request.resource.data.get('status', '') == 'pending';
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }
    match /carts/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    match /wishlists/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    match /activityLogs/{logId} {
      allow create: if isAdmin();
      allow read, update, delete: if isAdmin();
    }
  }
}
